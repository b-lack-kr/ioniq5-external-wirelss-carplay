{
  "id": "neev-usb-carplay",
  "name": "IONIQ 5 USB CarPlay",
  "version": "1.0.3",
  "hmgapi": ">=1.0.1",
  "authors": [
    "by blackr"
  ],
  "license": "AGPL-3.0",
  "description": "Wireless CarPlay over a compatible 5 GHz USB Wi-Fi adapter, with CarPlay/Android Auto cluster and HUD guidance. Korean NEEV 260902 only.",
  "system": {
    "model": "NEEV",
    "region": "KOR",
    "firmware": "260902",
    "platform": "tcc803x"
  },
  "feature_flags": [
    "com.hkmc.software.connectivity.carplay_wireless"
  ],
  "logs": {
    "tags": [
      "DiPO",
      "GPM",
      "Iap2",
      "GalReceiver"
    ],
    "match": [
      "HMG-API:"
    ]
  },
  "hooks": {
    "jar": "hooks.jar",
    "entry": "kr.ioniq5.usbcp.UsbCarplay",
    "points": {
      "iap2.service.on_create": "observe",
      "iap2.service_receiver.on_receive": "observe",
      "dipo.btcm.register_listener": "observe",
      "dipo.carplay.session_created": "observe",
      "dipo.carplay.session_started": "observe",
      "dipo.carplay.session_finalized": "observe",
      "dipo.carplay.iap_message": "observe",
      "dipo.utils.is_support_wireless_carplay": "replace",
      "dipo.iap2_listener.connected": "replace",
      "dipo.iap2_listener.disconnected": "replace",
      "dipo.iap2_listener.notify": "replace",
      "dipo.session_listener.session_details": "observe",
      "dipo.iap2.bt_address": "change",
      "dipo.bt.set_carplay_bt_address": "replace",
      "iap2.service.usbcp_send_wifi": "replace",
      "iap2.init_info.check_supports_features": "change",
      "dipo.iap2_proxy.stop_route_guidance": "observe",
      "framework.navigation_cluster.update_tbt_info": "replace",
      "framework.navigation_cluster.update_tbt_sub_info": "replace",
      "framework.navigation_cluster.update_tbt_sub_info_b": "replace",
      "framework.navigation_cluster.update_tbt_sub_info_2c": "replace",
      "framework.navigation_cluster.update_remain_dis": "replace",
      "framework.navigation_cluster.update_lane_info": "replace",
      "framework.navigation_cluster.update_tp_lane_info": "replace",
      "framework.navigation_cluster.update_tp_turn_list_new": "replace",
      "dipo.location.start": "observe",
      "dipo.location.stop": "observe",
      "dipo.location.sentence": "change",
      "dipo.location_speed.changed": "observe",
      "dipo.location_nmea.received": "observe",
      "dipo.iap2_proxy.send_location": "observe",
      "dipo.carplay.audio_stream_start": "observe",
      "dipo.carplay.audio_stream_stop": "observe",
      "dipo.session_listener.audio_stream_start": "change",
      "dipo.session_listener.audio_stream_stop": "change",
      "dipo.session_listener.duck": "change",
      "dipo.session_listener.unduck": "change",
      "framework.micom_audio.start_audio": "change",
      "framework.micom_audio.end_audio": "observe",
      "framework.micom_audio.start_dipo_music": "observe",
      "dipo.micom_listener.status_changed": "observe",
      "dipo.key_listener.all_keys": "observe",
      "dipo.audio_owner.start_music": "change",
      "dipo.mode_power_listener.power_off": "observe",
      "dipo.mode_power_listener.power_on": "observe",
      "phoneprojection.usbcp_settings.open": "replace",
      "btsettings.usbcp_settings.open": "replace",
      "dipo.carplay.screen_started": "observe",
      "dipo.carplay.screen_stopped": "observe",
      "dipo.carplay.screen_timeout": "observe",
      "dipo.carplay.decode_failure": "observe",
      "dipo.carplay.video_mode_changed": "observe",
      "dipo.carplay.show_display": "observe",
      "dipo.carplay.hide_display": "observe",
      "dipo.video_activity.resume": "observe",
      "dipo.video_activity.pause": "observe",
      "dipo.video_surface.created": "observe",
      "dipo.video_surface.changed": "observe",
      "dipo.video_surface.destroyed": "observe",
      "framework.context_impl.start_service": "replace",
      "gpm.navigation_status.init": "change",
      "gpm.navigation_status.next_turn": "observe",
      "gpm.navigation_status.next_turn_distance": "observe",
      "gpm.navigation_status.status": "observe",
      "gpm.receiver.send_navigation_focus": "observe",
      "gpm.receiver.destroy": "observe",
      "framework.navigation_cluster.update_tbt_trap_info": "replace",
      "framework.navigation_cluster.update_tbt_trap_info_new": "replace",
      "framework.navigation_cluster.update_clu_data_14": "replace",
      "framework.navigation_cluster.update_clu_data_new_14": "replace",
      "welcome.service.animation_status": "observe",
      "btsettings.usbcp_rows.bind": "observe",
      "btsettings.usbcp_devices.destroy": "observe"
    },
    "native": {
      "libCarPlayCore.so": [
        "recipes/carplay-core-wifi.recipe"
      ],
      "libCarPlayAudio.so": [
        "recipes/carplay-audio-formats.recipe"
      ],
      "libCarPlayUtils.so": [
        "recipes/carplay-utils-converter.recipe"
      ],
      "libCarPlayCoreUtils.so": [
        "recipes/carplay-usb-dongle-transport.recipe"
      ],
      "libautoreceiver_infobank.so": [
        "recipes/aa-tbt-48ee793a.recipe"
      ]
    }
  },
  "services": [
    {
      "name": "usb-ap",
      "script": "ap/service.sh",
      "user": "root",
      "start": "boot",
      "restart": true
    },
    {
      "name": "ap-provider",
      "jar": "provider.jar",
      "class": "kr.ioniq5.usbcp.Provider",
      "user": "root",
      "start": "android",
      "restart": true
    },
    {
      "name": "development-log",
      "jar": "provider.jar",
      "class": "kr.ioniq5.usbcp.DevelopmentLogger",
      "user": "root",
      "start": "android",
      "restart": true
    }
  ],
  "conflicts": [
    "wireless-carplay-aa"
  ]
}
